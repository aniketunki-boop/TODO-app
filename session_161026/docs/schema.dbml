Table todos {
  id          varchar(36) [pk]
  name        varchar(255) [not null]
  status      varchar(20)  [not null, default: 'pending', note: 'pending | in_progress | completed']
  created_at  datetime     [not null, default: `now()`]
  updated_at  datetime     [not null, default: `now()`]

  indexes {
    (created_at, id) [name: 'idx_todos_cursor']
  }
}